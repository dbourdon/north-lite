// OpenCode project config: use Cohere's North Mini Code as the coding agent.
// Run through scripts/opencode-cohere.sh, which loads CO_API_KEY from .env.
// Format per opencode.ai/docs/providers (checked 2026-11-19); if OpenCode rejects
// it, compare with `opencode --help` and that page.
{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "cohere": {
      "name": "Cohere",
      "env": ["CO_API_KEY"],
      // Cohere's OpenAI-compatible endpoint (Compatibility API).
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.cohere.ai/compatibility/v1"
      },
      "models": {
        "north-mini-code-1.0": { "name": "North Mini Code 1.0" },
        "command-a-plus-05-2026": { "name": "Command A+" }
      }
    }
  },
  "model": "cohere/north-mini-code-1.0"
}
