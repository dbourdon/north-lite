{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "north-lite values",
  "description": "Helm validates values against this on install, upgrade, template and lint, so a bad --set fails before anything reaches the cluster.",
  "type": "object",
  "required": ["image", "config", "features", "apiKey", "service"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": { "enum": ["cohere", "fake"] },
        "chatModel": { "type": "string", "minLength": 1 },
        "embedModel": { "type": "string", "minLength": 1 },
        "rerankModel": { "type": "string", "minLength": 1 },
        "timeoutS": { "type": "number", "exclusiveMinimum": 0 },
        "maxAttempts": { "type": "integer", "minimum": 1 }
      }
    },
    "features": {
      "description": "Closed set: a typo like features.rerak fails instead of being silently ignored.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rerank": { "type": "boolean" },
        "streaming": { "type": "boolean" },
        "cache": { "type": "boolean" },
        "requireApproval": { "type": "boolean" }
      }
    },
    "apiKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowDNS": { "type": "boolean" },
        "extraEgress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" }
  }
}
